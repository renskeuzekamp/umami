# Umami environment for this fork (analytics.rensranks.dev on Vercel).
# Copy to .env for local work. On Vercel these live in Project > Settings >
# Environment Variables and are NOT read from this file. Never commit a real .env.

# --- Required ---------------------------------------------------------------
# Pooled Postgres connection used by the running app (PgBouncer / pooler URL).
DATABASE_URL=postgresql://user:password@host:5432/umami

# Direct (non-pooled) connection. Used by the build for migrations
# (scripts/check-db.js runs `prisma migrate deploy` against it) and for backups.
DIRECT_DATABASE_URL=postgresql://user:password@host:5432/umami

# Signs every login token, share token and cache key. Rotating it logs everyone
# out and invalidates all share links. Generate with: openssl rand -hex 32
APP_SECRET=replace-me-with-a-random-string

# --- Privacy / phoning home (audit UMAMI-P3-021) ----------------------------
# Stops the build (scripts/postbuild.js) and the dashboard (/telemetry.js pixel)
# from reporting version, Node and OS details to api.umami.is / i.umami.is.
DISABLE_TELEMETRY=1

# Stops the dashboard fetching https://api.umami.is/v1/updates on load.
# Leaving this unset keeps the in-app "new version" banner, which is handy;
# with it set, rely on the monthly upstream check in docs/OPERATIONS.md.
DISABLE_UPDATES=1

# --- Security (optional, see docs/OPERATIONS.md) ----------------------------
# 64-character hex key that encrypts 2FA secrets at rest. Without it two-factor
# auth cannot be enabled. Generate with: openssl rand -hex 32
# Only turn 2FA on at v3.4.0 or later (partial-token bypass fixed upstream).
#TWO_FACTOR_ENCRYPTION_KEY=

# Optional Redis for server-side sessions (revocable logins). Without it,
# sessions are stateless JWTs that only expire when the password changes.
#REDIS_URL=

# --- Build-time switches ----------------------------------------------------
# Useful for a local `pnpm build` without a reachable database or a geo download.
#SKIP_DB_CHECK=1
#SKIP_DB_MIGRATION=1
#SKIP_BUILD_GEO=1
